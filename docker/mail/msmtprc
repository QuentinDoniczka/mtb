# Relais local uniquement — vers le service "mail" (Mailpit) du compose.yaml.
# Aucune configuration ne pointe vers un service externe : c'est une exigence du projet
# (BRIEF §12 / D6), y compris pour les outils de développement.
#
# Fichier partagé par les deux images qui appellent wp_mail() : "wordpress" (Apache/www-data,
# requêtes web — dont le formulaire de contact #22) et "wpcli" (provisionnement, commandes
# ponctuelles). Voir docker/wordpress/Dockerfile et docker/wpcli/Dockerfile pour les
# permissions appliquées à ce fichier dans chaque image — il ne contient aucun secret
# (pas d'identifiant, pas de mot de passe), seule l'adresse locale du relais.
defaults
auto_from off
from no-reply@mtbrabant.local

account default
host mail
port 1025
