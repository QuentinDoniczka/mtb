{
	"apiVersion": 3,
	"name": "mtb/fiche-information",
	"title": "Fiche d'information",
	"description": "Un titre, des paragraphes et une photo : la brique de base des pages de contenu.",
	"category": "mtb",
	"icon": "media-text",
	"keywords": [ "photo", "texte", "paragraphe", "titre", "section" ],
	"attributes": {
		"titre": {
			"type": "string",
			"default": ""
		},
		"niveau_titre": {
			"type": "string",
			"default": "h2",
			"enum": [ "h2", "h3" ]
		},
		"photo_id": {
			"type": "number",
			"default": 0
		},
		"photo_description": {
			"type": "string",
			"default": ""
		},
		"photo_legende": {
			"type": "string",
			"default": ""
		},
		"cadrage": {
			"type": "string",
			"default": "centre",
			"enum": [ "haut_gauche", "haut", "centre", "haut_droite", "bas" ]
		},
		"position_photo": {
			"type": "string",
			"default": "dessus",
			"enum": [ "dessus", "dessous" ]
		}
	},
	"supports": {
		"align": false,
		"alignWide": false,
		"anchor": false,
		"ariaLabel": false,
		"className": false,
		"customClassName": false,
		"html": false,
		"lock": false,
		"renaming": false,
		"reusable": false,
		"splitting": false,
		"layout": false,
		"position": false,
		"border": false,
		"shadow": false,
		"inserter": true,
		"multiple": true,
		"color": {
			"background": false,
			"text": false,
			"link": false,
			"gradients": false,
			"button": false,
			"enableContrastChecker": false
		},
		"typography": {
			"fontSize": false,
			"lineHeight": false,
			"textAlign": false
		},
		"spacing": {
			"margin": false,
			"padding": false,
			"blockGap": false
		},
		"dimensions": {
			"aspectRatio": false,
			"minHeight": false
		},
		"background": {
			"backgroundImage": false,
			"backgroundSize": false
		},
		"filter": {
			"duotone": false
		}
	},
	"example": {
		"attributes": {
			"titre": "Titre de la fiche",
			"niveau_titre": "h2",
			"photo_id": 0
		},
		"innerBlocks": [
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Un paragraphe de présentation."
				}
			}
		]
	},
	"editorScript": "mtb-fiche-information-editeur",
	"render": "file:./render.php"
}
