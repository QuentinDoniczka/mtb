# Copier ce fichier en .env avant le premier démarrage : `cp .env.example .env`
# .env n'est jamais commité (voir .gitignore). Toutes les valeurs ci-dessous sont des
# identifiants de développement local — sans rapport avec la production.

# --- Base de données ---
MYSQL_DATABASE=mtb
MYSQL_USER=mtb
MYSQL_PASSWORD=mtb-dev-password
MYSQL_ROOT_PASSWORD=mtb-dev-root-password

# --- WordPress ---
WP_PORT=3005
WP_SITE_URL=http://localhost:3005
WP_SITE_TITLE=Berger Hollandais du Mont Brabant

# Compte administrateur technique (nous)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=mtb-dev-admin
WP_ADMIN_EMAIL=admin@mtbrabant.local

# Compte de l'éditrice (Fabienne Guéneau) — rôle WordPress natif "Éditeur", jamais "Administrateur"
WP_EDITOR_USER=fabienne
WP_EDITOR_PASSWORD=mtb-dev-editrice
WP_EDITOR_EMAIL=mtbrabant@gmail.com

WORDPRESS_DEBUG=1

# --- Mailpit (capteur de courrier local, formulaire de contact) ---
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- Jeu de démonstration (portées, chiens, résultats fictifs) ---
# Au premier démarrage, la pile affiche un site déjà rempli avec du contenu FICTIF (des
# portées, des chiens et des résultats qui n'existent pas réellement), pour qu'il y ait
# toujours quelque chose à voir plutôt qu'une page vide.
#
# Le jour où vous voulez reprendre le VRAI contenu de l'ancien site (l'import réel, pas la
# démonstration), ce contenu fictif doit d'abord être absent, sans quoi l'import refuse de
# se lancer pour ne pas mélanger le vrai et le faux. Mettez alors MTB_FIXTURES=0 ci-dessous
# et redémarrez la pile à froid : le site démarrera vide de démonstration, prêt pour le vrai
# contenu. Remettez 1 (ou effacez la ligne) pour retrouver le site de démonstration.
MTB_FIXTURES=1
