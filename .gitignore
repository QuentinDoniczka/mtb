# Contenu et bases de données — jamais versionnés
wp-content/uploads/
*.sql
*.sql.gz
dumps/

# Secrets et configuration locale
.env
.env.*
!.env.example

# WordPress core (si jamais rapatrié dans l'arbre)
/wordpress/
wp-config.php

# Dépendances
node_modules/
vendor/

# Bruit éditeur / OS
.DS_Store
Thumbs.db

# Feuilles de style minifiées (#40) — NE RIEN AJOUTER ICI.
# Les artefacts `wp-content/themes/mtb/assets/css/**/*.min.css` sont VERSIONNÉS : la production
# est un hébergement mutualisé, sans étape de construction, et une feuille absente y serait
# servie non minifiée. Aucune règle ci-dessus ne les exclut, et ce bloc n'en ajoute aucune : un
# `.gitignore` ne sait pas « dé-ignorer » ce qui n'est pas ignoré, une ligne de négation ne
# serait qu'un faux-semblant. Ce commentaire est là pour arrêter la main qui écrirait
# `*.min.css` par réflexe.
